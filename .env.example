# Required
FRED_API_KEY=your_fred_api_key_here

# Optional — increases BLS rate limits from 25/day to 500/day
BLS_API_KEY=

# Optional — Marketstack
MARKETSTACK_API_KEY=

# Optional — Tiingo free-tier EOD data (tiingo.com → API → Token)
TIINGO_API_KEY=

# Alpaca — taxable-sleeve automated executor (use PAPER keys first)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=1

# Optional
LOG_LEVEL=INFO
CACHE_DIR=.cache
